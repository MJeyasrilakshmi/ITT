class Solution {
    public static void sortColors(int[] nums) {
        int n = nums.length;
        for(int i =0;i<n-1;i++){
            int m =i;
            for(int j=i+1;j<n;j++){
                if(nums[m] > nums[j]){
                    m = j;
                }
            }
            int temp = nums[m];
            nums[m] = nums[i];
            nums[i] = temp;
        }
        System.out.println(nums);
    }
    public static void main(){
        int[] nums = {2,0,2,1,1,0};
        sortColors(nums);
    }
}
