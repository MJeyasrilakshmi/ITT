class Solution {
    public static int[] twoSum(int[] nums, int target) {
		int n = nums.length;
		for(int i =0;i<n;i++) {
			for (int j =i+1;j<n;j++) {
				if(nums[i]+nums[j]==target) {
                    int b[] ={i,j}; 
					return b;
                }
            }
        }
        return nums;
    }
    public static void main(String args[]) {
        int a[] = {2,7,11,15};
        int target = 9;
        System.out.println(twoSum(a,target));
	}
}
